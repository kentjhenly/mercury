# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side ONLY. Never expose to the browser. Bypasses RLS — every query must
# still filter by owner_id in code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Pooled connection string (Better Auth + migration runner use this).
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Better Auth ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-32-char-random-secret
BETTER_AUTH_URL=http://localhost:3000

# ── Resend (outbound candidate responses) ───────────────────────────────────
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Inbound email ingestion [CRITICAL] ──────────────────────────────────────
# Shared secret the inbound email worker/webhook must present (header
# `x-inbound-secret` or `Authorization: Bearer <secret>`). Reject unsigned posts.
INBOUND_SECRET=your-long-random-inbound-secret
# The domain applicant-forwarding addresses are built on, e.g. set to
# "apply.yourdomain.com" so a role's address is apply+<token>@apply.yourdomain.com
MERCURY_INBOUND_DOMAIN=apply.yourdomain.com
# Production transport: deploy cloudflare/email-worker (Cloudflare Email Routing
# catch-all → Worker), giving it the SAME INBOUND_SECRET and MERCURY_INGEST_URL
# = <this app>/api/mercury/inbound. See cloudflare/email-worker/README.md.

# ── Cron (Vercel Cron sends this as a Bearer token) ─────────────────────────
CRON_SECRET=your-cron-secret

# ── PostHog (validation funnel) ─────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
